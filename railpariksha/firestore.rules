// RailPariksha Firestore rules -- paste into Firebase Console > Firestore Database >
// Rules tab > Publish. The leaderboard is anonymous by design (device id + a chosen
// display name; Google sign-in is optional and only pre-fills the name), so its rules
// validate the SHAPE of a write, not "this write really came from that device" --
// a client could in principle overwrite another device's entry. Accepted for v1; the
// real hardening step later is Firebase App Check (free, Play Integrity-based) to at
// least confirm writes come from the real app, not an arbitrary script.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboards/{examId}/weeks/{weekId}/entries/{deviceId} {
      allow read: if true;

      allow write: if request.resource.data.keys().hasOnly(['name', 'score', 'total', 'updatedAt'])
                   && request.resource.data.name is string
                   && request.resource.data.name.size() > 0
                   && request.resource.data.name.size() <= 20
                   && request.resource.data.total is number
                   && request.resource.data.total > 0
                   && request.resource.data.total <= 200
                   && request.resource.data.score is number
                   && request.resource.data.score <= request.resource.data.total;
    }

    // Progress backup (Google sign-in required): each user reads/writes only their own document,
    // and only in the shape the app writes (see lib/logic/progress_backup.dart).
    // (Rules are OR-ed, so there is deliberately no blanket `allow write` here: a create or
    // update must pass the shape check below, and only the owner may read or delete.)
    match /users/{uid}/backup/progress {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['v', 'gz', 'xp', 'answered', 'streak', 'at'])
                   && request.resource.data.gz is string
                   && request.resource.data.gz.size() <= 950000;
    }

    // Error reports from the quiz screen ("Report an error"): create-only and shape-checked, so a
    // client can file a report but never read, change or delete anyone's. Read them in the console.
    match /reports/{reportId} {
      allow create: if request.resource.data.keys().hasOnly(['qid', 'reason', 'lang', 'pyq', 'at'])
                   && request.resource.data.qid is string && request.resource.data.qid.size() > 0 && request.resource.data.qid.size() <= 60
                   && request.resource.data.reason is string && request.resource.data.reason.size() <= 80
                   && request.resource.data.lang in ['hi', 'en']
                   && request.resource.data.pyq is bool;
    }

    // Everything else is closed by default (no catch-all allow).
  }
}
